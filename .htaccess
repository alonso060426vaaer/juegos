# Zona de Juegos - control de cache
#
# El HTML se revalida siempre (es pequeno y asi los cambios llegan solos).
# El resto de archivos llevan ?v=NN en el enlace, asi que pueden guardarse
# mucho tiempo: cuando cambian, cambia el numero y el navegador los vuelve a pedir.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  <FilesMatch "\.(css|js|png|jpg|jpeg|svg|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
